/* 微信风格主题 */

QMainWindow#MainWindow,
QStackedWidget#page_stack,
QDialog#LoginDialog,
QDialog#RegisterDialog,
QDialog#ResetDialog {
    background-color: #FFFFFF;
    border: none;
}

QLabel#title_lb {
    color: #191919;
    font-size: 20px;
    font-weight: bold;
    padding-top: 12px;
}

QLabel#logo_lb {
    background: transparent;
}

QLabel#err_tip {
    font-size: 12px;
    padding: 6px 4px 2px 4px;
    min-height: 18px;
}

QLabel#err_tip[state='normal'] {
    color: #07C160;
}

QLabel#err_tip[state='err'] {
    color: #FA5151;
}

/* 输入框分组（微信卡片式） */
QFrame#input_frame {
    background-color: #FFFFFF;
    border: 1px solid #E5E5E5;
    border-radius: 4px;
}

QFrame#divider1,
QFrame#divider2,
QFrame#divider3 {
    background-color: #E5E5E5;
    border: none;
    max-height: 1px;
}

QFrame#input_frame QLineEdit,
QLineEdit#varify_edit {
    background-color: #FFFFFF;
    border: none;
    border-radius: 0;
    padding: 10px 14px;
    color: #191919;
    font-size: 14px;
    selection-background-color: #95EC69;
    selection-color: #191919;
}

QLineEdit::placeholder {
    color: #B2B2B2;
}

QLineEdit#varify_edit {
    border: 1px solid #E5E5E5;
    border-radius: 4px;
}

QLineEdit#varify_edit:focus {
    border-color: #07C160;
}

/* 微信绿主按钮 */
QPushButton#login_btn,
QPushButton#sure_btn {
    background-color: #07C160;
    color: #FFFFFF;
    border: none;
    border-radius: 4px;
    font-size: 16px;
    font-weight: bold;
    padding: 10px;
    margin-top: 20px;
}

QPushButton#login_btn:hover,
QPushButton#sure_btn:hover {
    background-color: #06AD56;
}

QPushButton#login_btn:pressed,
QPushButton#sure_btn:pressed {
    background-color: #059A4C;
}

QPushButton#login_btn:disabled,
QPushButton#sure_btn:disabled {
    background-color: #91D4A8;
    color: #FFFFFF;
}

/* 验证码按钮 */
QPushButton#varify_btn {
    background-color: #FFFFFF;
    color: #07C160;
    border: 1px solid #07C160;
    border-radius: 4px;
    font-size: 13px;
}

QPushButton#varify_btn:hover {
    background-color: #F0FFF4;
}

QPushButton#varify_btn:pressed {
    background-color: #E6F9EC;
}

QPushButton#varify_btn:disabled {
    color: #B2B2B2;
    border-color: #E5E5E5;
    background-color: #F7F7F7;
}

/* 微信链接色 */
QPushButton#reg_btn,
QPushButton#cancel_btn {
    color: #576B95;
    font-size: 14px;
    background: transparent;
    border: none;
    padding: 4px 8px;
}

QPushButton#reg_btn:hover,
QPushButton#cancel_btn:hover,
QPushButton#return_btn:hover {
    color: #3E5A8A;
}

QPushButton#return_btn {
    color: #576B95;
    font-size: 14px;
    background: transparent;
    border: none;
    padding: 4px 8px;
}

#RegisterDialog #tip_lb {
    color: #191919;
    font-size: 16px;
    padding: 12px;
}

#pass_visible[state='unvisible'],
#confirm_visible[state='unvisible'],
#pwd_visible[state='unvisible'] {
    border-image: url(:/res/unvisible.png);
}

#pass_visible[state='unvisible_hover'],
#confirm_visible[state='unvisible_hover'],
#pwd_visible[state='unvisible_hover'] {
    border-image: url(:/res/unvisible_hover.png);
}

#pass_visible[state='visible'],
#confirm_visible[state='visible'],
#pwd_visible[state='visible'] {
    border-image: url(:/res/visible.png);
}

#pass_visible[state='visible_hover'],
#confirm_visible[state='visible_hover'],
#pwd_visible[state='visible_hover'] {
    border-image: url(:/res/visible_hover.png);
}

QHBoxLayout#passRowLayout,
QHBoxLayout#confirmRowLayout,
QHBoxLayout#pwdRowLayout {
    margin-right: 8px;
}

QFrame#input_frame QHBoxLayout QLineEdit {
    padding-right: 4px;
}

#forget_label[state='normal'] {
    color: #576B95;
    font-size: 13px;
    padding: 4px 0;
}

#forget_label[state='hover'],
#forget_label[state='selected_hover'] {
    color: #3E5A8A;
    font-size: 13px;
    padding: 4px 0;
}

#forget_label[state='selected'] {
    color: #576B95;
    font-size: 13px;
    padding: 4px 0;
}

/* day18 聊天主界面 */
QDialog#ChatDialog {
    background-color: #F5F5F5;
}

#side_bar {
    background-color: rgb(46, 46, 46);
}

#side_head_lb {
    border-radius: 4px;
}

#side_chat_lb[state='normal'] {
