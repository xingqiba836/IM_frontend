}

#side_chat_lb[state='pressed'] {
    border-image: url(:/res/chat_icon_press.png);
}

#side_chat_lb[state='selected_normal'] {
    border-image: url(:/res/chat_icon_press.png);
}

#side_chat_lb[state='selected_hover'] {
    border-image: url(:/res/chat_icon_press.png);
}

#side_chat_lb[state='selected_pressed'] {
    border-image: url(:/res/chat_icon_press.png);
}

#side_contact_lb[state='normal'] {
    border-image: url(:/res/contact_list.png);
}

#side_contact_lb[state='hover'] {
    border-image: url(:/res/contact_list_hover.png);
}

#side_contact_lb[state='pressed'] {
    border-image: url(:/res/contact_list_press.png);
}

#side_contact_lb[state='selected_normal'] {
    border-image: url(:/res/contact_list_press.png);
}

#side_contact_lb[state='selected_hover'] {
    border-image: url(:/res/contact_list_press.png);
}

#side_contact_lb[state='selected_pressed'] {
    border-image: url(:/res/contact_list_press.png);
}

#left_panel {
    background-color: #E6E6E6;
    border-right: 1px solid #D6D6D6;
}

#search_wid {
    background-color: rgb(247, 247, 247);
    border-bottom: 1px solid #DCDCDC;
}

#search_edit {
    border: 2px solid #f1f1f1;
    background-color: #FFFFFF;
    border-radius: 4px;
    padding: 6px 10px;
    color: #191919;
}

#add_btn[state='normal'] {
    border-image: url(:/res/add_friend_normal.png);
}

#add_btn[state='hover'] {
    border-image: url(:/res/add_friend_hover.png);
}

#add_btn[state='press'] {
    border-image: url(:/res/add_friend_hover.png);
}

QDialog#FindSuccessDlg {
    background-color: #FFFFFF;
    border: 1px solid #D6D6D6;
    border-radius: 4px;
}

#FindSuccessDlg #name_lb {
    color: #191919;
    font-size: 14px;
    font-family: "Microsoft YaHei";
}

#FindSuccessDlg #add_friend_btn[state='normal'] {
    border-image: url(:/res/add_friend_normal.png);
}

#FindSuccessDlg #add_friend_btn[state='hover'] {
    border-image: url(:/res/add_friend_hover.png);
}

#FindSuccessDlg #add_friend_btn[state='press'] {
    border-image: url(:/res/add_friend_hover.png);
}

#FindSuccessDlg #close_btn[state='normal'] {
    border-image: url(:/res/close_search.png);
}

#FindSuccessDlg #close_btn[state='hover'] {
    border-image: url(:/res/close_search.png);
}

#FindSuccessDlg #close_btn[state='press'] {
    border-image: url(:/res/close_search.png);
}

#ApplyFriend {
    border: 2px solid #f1f1f1;
    font-size: 14px;
    background: #f7f7f8;
}

#scrollArea {
    background: #f7f7f8;
    border: none;
}

#scrollcontent {
    background: #f7f7f8;
}

#scrollcontent #apply_lb {
    font-family: "Microsoft YaHei";
    font-size: 16px;
    font-weight: normal;
}

#apply_wid #apply_lb,
#apply_wid #label,
#apply_wid #label_2,
#apply_wid #label_3 {
    color: rgb(140, 140, 140);
    font-size: 14px;
    font-family: "Microsoft YaHei";
    height: 25px;
}

#apply_wid #name_ed,
#apply_wid #back_ed {
    border: 1px solid #f7f7f8;
    font-size: 14px;
    font-family: "Microsoft YaHei";
}

#apply_wid #lb_ed {
    border: none;
    font-size: 14px;
    font-family: "Microsoft YaHei";
}

#apply_wid #more_lb {
    border-image: url(:/res/arowdown.png);
}

#apply_wid #tipslb[state='normal'],
#apply_wid #tipslb[state='hover'],
#apply_wid #tipslb[state='pressed'] {
    padding: 2px;
    background: #e1e1e1;
    color: #1e1e1e;
    border-radius: 10px;
}

#apply_wid #tipslb[state='selected_normal'],
#apply_wid #tipslb[state='selected_hover'] {
    padding: 2px;
    background: #e1e1e1;
    color: #48bf56;
    border-radius: 10px;
}

#apply_wid #tipslb[state='selected_pressed'] {
    padding: 2px;
    background: #e1e1e1;
    color: #1e1e1e;
    border-radius: 10px;
}

#input_tip_wid {
    background: #d3eaf8;
}

#apply_wid #FriendLabel {
    background: #daf6e7;
    color: #48bf56;
    border-radius: 10px;
}

#FriendLabel #tip_lb {
    padding: 0px;
    color: #48bf56;
    font-size: 14px;
    font-family: "Microsoft YaHei";
    background: transparent;
    min-height: 0px;
    max-height: 16777215px;
}

#input_tip_wid #tip_lb {
    padding-left: 2px;
    color: rgb(153, 153, 153);
    font-size: 14px;
    font-family: "Microsoft YaHei";
}

#gridWidget {
    background: #fdfdfd;
}

#close_lb[state='normal'],
#close_lb[state='hover'],
#close_lb[state='pressed'],
#close_lb[state='selected_normal'],
#close_lb[state='selected_hover'],
#close_lb[state='selected_pressed'] {
