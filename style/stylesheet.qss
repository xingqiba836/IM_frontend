}

#apply_sure_wid #sure_btn[state='normal'],
#apply_sure_wid #sure_btn[state='hover'],
#apply_sure_wid #sure_btn[state='press'] {
    margin: 0;
    padding: 0;
    min-width: 100px;
    min-height: 30px;
}

#apply_sure_wid #sure_btn[state='normal'] {
    background: #f0f0f0;
    color: #2cb46e;
    font-size: 16px;
    font-family: "Microsoft YaHei";
    border-radius: 20px;
}

#apply_sure_wid #sure_btn[state='hover'] {
    background: #d2d2d2;
    color: #2cb46e;
    font-size: 16px;
    font-family: "Microsoft YaHei";
    border-radius: 20px;
}

#apply_sure_wid #sure_btn[state='press'] {
    background: #c6c6c6;
    color: #2cb46e;
    font-size: 16px;
    font-family: "Microsoft YaHei";
    border-radius: 20px;
}

#apply_sure_wid #cancel_btn[state='normal'],
#apply_sure_wid #cancel_btn[state='hover'],
#apply_sure_wid #cancel_btn[state='press'] {
    margin: 0;
    padding: 0;
    min-width: 100px;
    min-height: 30px;
}

#apply_sure_wid #cancel_btn[state='normal'] {
    background: #f0f0f0;
    color: #2e2f30;
    font-size: 16px;
    font-family: "Microsoft YaHei";
    border-radius: 20px;
}

#apply_sure_wid #cancel_btn[state='hover'] {
    background: #d2d2d2;
    color: #2e2f30;
    font-size: 16px;
    font-family: "Microsoft YaHei";
    border-radius: 20px;
}

#apply_sure_wid #cancel_btn[state='press'] {
    background: #c6c6c6;
    color: #2e2f30;
    font-size: 16px;
    font-family: "Microsoft YaHei";
    border-radius: 20px;
}

